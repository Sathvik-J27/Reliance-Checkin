# Environment files (never commit secrets)
backend/.env
backend/.env.production
frontend/.env
frontend/.env.local

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build output (built fresh on every Railway deploy — must NOT be committed,
# or Nixpacks' post-build COPY step re-introduces the stale committed copy
# and clobbers the fresh build)
frontend/build/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
